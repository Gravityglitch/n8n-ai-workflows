{
  "name": "Lead intake -> AI scoring -> approved CRM + booking",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000001",
      "name": "Lead Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "lead-intake"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "name", "value": "={{ $json.body.name }}", "type": "string" },
            { "id": "f2", "name": "email", "value": "={{ $json.body.email }}", "type": "string" },
            { "id": "f3", "name": "company", "value": "={{ $json.body.company || null }}", "type": "string" },
            { "id": "f4", "name": "role", "value": "={{ $json.body.role || null }}", "type": "string" },
            { "id": "f5", "name": "company_size", "value": "={{ $json.body.company_size ? Number($json.body.company_size) : null }}", "type": "number" },
            { "id": "f6", "name": "budget_usd", "value": "={{ $json.body.budget_usd ? Number($json.body.budget_usd) : null }}", "type": "number" },
            { "id": "f7", "name": "message", "value": "={{ $json.body.message || '' }}", "type": "string" },
            { "id": "f8", "name": "source", "value": "web_form", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000002",
      "name": "Normalise Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SIDECAR_URL }}/score",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.SIDECAR_API_KEY }}" },
            { "name": "Idempotency-Key", "value": "={{ $json.email + ':' + $now.toFormat('yyyy-LL-dd') }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": { "timeout": 30000 }
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000003",
      "name": "Score Lead (sidecar)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.score }}",
              "rightValue": "={{ $json.threshold }}",
              "operator": { "type": "number", "operation": "gte" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000004",
      "name": "Qualified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SIDECAR_URL }}/actions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.SIDECAR_API_KEY }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'create_crm_contact', requested_by: 'n8n/lead-intake', resume_url: $execution.resumeUrl, payload: { lead: $('Normalise Lead').item.json, score: $json.score, reasons: $json.reasons } }) }}",
        "options": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000005",
      "name": "Request CRM Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 160]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#lead-approvals" },
        "text": "=:fire: Hot lead *{{ $('Normalise Lead').item.json.name }}* ({{ $('Normalise Lead').item.json.email }}) scored {{ $('Score Lead (sidecar)').item.json.score }}.\nReasons: {{ $('Score Lead (sidecar)').item.json.reasons.join('; ') }}\nApprove CRM contact + booking offer:\n`curl -X POST $SIDECAR_URL/approve/{{ $json.id }} -H 'X-API-Key: $SIDECAR_API_KEY'`\nReject: `curl -X POST $SIDECAR_URL/reject/{{ $json.id }} -H 'X-API-Key: $SIDECAR_API_KEY'`",
        "otherOptions": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000006",
      "name": "Notify Reviewer (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1120, 160],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "limitWaitTime": true,
        "resumeAmount": 24,
        "resumeUnit": "hours",
        "options": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000007",
      "name": "Wait for Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 160],
      "webhookId": "lead-crm-approval"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.body.status }}",
              "rightValue": "approved",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000008",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 160]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Normalise Lead').item.json.email }}",
        "subject": "=Thanks {{ $('Normalise Lead').item.json.name }} - pick a discovery-call slot",
        "emailType": "text",
        "message": "=Hi {{ $('Normalise Lead').item.json.name }},\n\nThanks for reaching out. Here are three slots for a 30-minute discovery call:\n{{ $json.body.result.proposed_slots.map(s => '- ' + s).join('\\n') }}\n\nReply with the one that suits you.\n\nBest,\nSales team",
        "options": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000009",
      "name": "Send Booking Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1800, 60],
      "credentials": { "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#lead-approvals" },
        "text": "=:white_check_mark: CRM contact {{ $('Wait for Approval').item.json.body.result.contact_id }} created for {{ $('Normalise Lead').item.json.email }}; booking slots emailed.",
        "otherOptions": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000010",
      "name": "Confirm in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [2020, 60],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#lead-approvals" },
        "text": "=:no_entry: Action {{ $json.body.id }} was {{ $json.body.status }}{{ $json.body.error ? ' (' + $json.body.error + ')' : '' }}. No CRM write was made.",
        "otherOptions": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000011",
      "name": "Log Rejection (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1800, 260],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SIDECAR_URL }}/actions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.SIDECAR_API_KEY }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'send_email', requested_by: 'n8n/lead-intake', resume_url: $execution.resumeUrl, payload: { to: $('Normalise Lead').item.json.email, subject: 'Thanks for your interest', body: 'Hi ' + $('Normalise Lead').item.json.name + ', thanks for getting in touch. Here is a short guide that answers the most common questions; we will follow up next week.' } }) }}",
        "options": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000012",
      "name": "Request Nurture Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 460]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#lead-approvals" },
        "text": "=:seedling: Lead {{ $('Normalise Lead').item.json.email }} scored {{ $('Score Lead (sidecar)').item.json.score }} (below threshold). Approve nurture email: `curl -X POST $SIDECAR_URL/approve/{{ $json.id }} -H 'X-API-Key: $SIDECAR_API_KEY'`",
        "otherOptions": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000013",
      "name": "Notify Reviewer (Nurture)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1120, 460],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "limitWaitTime": true,
        "resumeAmount": 72,
        "resumeUnit": "hours",
        "options": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000014",
      "name": "Wait for Nurture Approval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 460],
      "webhookId": "lead-nurture-approval"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#lead-approvals" },
        "text": "=Nurture email for {{ $('Normalise Lead').item.json.email }}: {{ $json.body.status }}{{ $json.body.result ? ' (message ' + $json.body.result.message_id + ')' : '' }}",
        "otherOptions": {}
      },
      "id": "a1f0c2e4-0001-4c1e-9a00-000000000015",
      "name": "Nurture Outcome (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1560, 460],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Lead Form Webhook": { "main": [[{ "node": "Normalise Lead", "type": "main", "index": 0 }]] },
    "Normalise Lead": { "main": [[{ "node": "Score Lead (sidecar)", "type": "main", "index": 0 }]] },
    "Score Lead (sidecar)": { "main": [[{ "node": "Qualified?", "type": "main", "index": 0 }]] },
    "Qualified?": {
      "main": [
        [{ "node": "Request CRM Approval", "type": "main", "index": 0 }],
        [{ "node": "Request Nurture Approval", "type": "main", "index": 0 }]
      ]
    },
    "Request CRM Approval": { "main": [[{ "node": "Notify Reviewer (Slack)", "type": "main", "index": 0 }]] },
    "Notify Reviewer (Slack)": { "main": [[{ "node": "Wait for Approval", "type": "main", "index": 0 }]] },
    "Wait for Approval": { "main": [[{ "node": "Approved?", "type": "main", "index": 0 }]] },
    "Approved?": {
      "main": [
        [{ "node": "Send Booking Email", "type": "main", "index": 0 }],
        [{ "node": "Log Rejection (Slack)", "type": "main", "index": 0 }]
      ]
    },
    "Send Booking Email": { "main": [[{ "node": "Confirm in Slack", "type": "main", "index": 0 }]] },
    "Request Nurture Approval": { "main": [[{ "node": "Notify Reviewer (Nurture)", "type": "main", "index": 0 }]] },
    "Notify Reviewer (Nurture)": { "main": [[{ "node": "Wait for Nurture Approval", "type": "main", "index": 0 }]] },
    "Wait for Nurture Approval": { "main": [[{ "node": "Nurture Outcome (Slack)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveExecutionProgress": true },
  "active": false,
  "pinData": {},
  "tags": [{ "name": "ai" }, { "name": "lead-intake" }],
  "meta": { "templateCredsSetupCompleted": false }
}
