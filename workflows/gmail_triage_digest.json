{
  "name": "Gmail triage -> AI classify -> Slack digest + labels",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 1 }] } },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000001",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "limit": 25,
        "simple": true,
        "filters": { "readStatus": "unread", "labelIds": ["INBOX"] },
        "options": {}
      },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000002",
      "name": "Fetch Unread",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [220, 300],
      "credentials": { "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" } }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "id", "value": "={{ $json.id }}", "type": "string" },
            { "id": "e2", "name": "from", "value": "={{ $json.From }}", "type": "string" },
            { "id": "e3", "name": "subject", "value": "={{ $json.Subject }}", "type": "string" },
            { "id": "e4", "name": "body", "value": "={{ $json.snippet }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000003",
      "name": "Shape Emails",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 300]
    },
    {
      "parameters": { "aggregate": "aggregateAllItemData", "destinationFieldName": "emails", "options": {} },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000004",
      "name": "Collect",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SIDECAR_URL }}/triage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.SIDECAR_API_KEY }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ emails: $json.emails }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000005",
      "name": "Triage (sidecar)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#inbox-digest" },
        "text": "={{ $json.digest_markdown }}",
        "otherOptions": {}
      },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000006",
      "name": "Post Digest (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1100, 160],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    },
    {
      "parameters": { "fieldToSplitOut": "results", "options": {} },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000007",
      "name": "Split Results",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1100, 440]
    },
    {
      "parameters": {
        "operation": "addLabels",
        "messageId": "={{ $json.id }}",
        "labelIds": "={{ [ $json.label ] }}"
      },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000008",
      "name": "Apply Label",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1320, 440],
      "credentials": { "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "p1",
              "leftValue": "={{ $('Split Results').item.json.priority }}",
              "rightValue": "high",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000009",
      "name": "High Priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1540, 440]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#inbox-urgent" },
        "text": "=:rotating_light: *{{ $('Split Results').item.json.subject }}* from {{ $('Split Results').item.json.sender }}\n{{ $('Split Results').item.json.summary }}\nActions: {{ $('Split Results').item.json.action_items.join(' | ') || 'none' }}",
        "otherOptions": {}
      },
      "id": "b2e1d3f5-0002-4c1e-9a00-000000000010",
      "name": "Ping Owner (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1760, 340],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Every Hour": { "main": [[{ "node": "Fetch Unread", "type": "main", "index": 0 }]] },
    "Fetch Unread": { "main": [[{ "node": "Shape Emails", "type": "main", "index": 0 }]] },
    "Shape Emails": { "main": [[{ "node": "Collect", "type": "main", "index": 0 }]] },
    "Collect": { "main": [[{ "node": "Triage (sidecar)", "type": "main", "index": 0 }]] },
    "Triage (sidecar)": {
      "main": [
        [
          { "node": "Post Digest (Slack)", "type": "main", "index": 0 },
          { "node": "Split Results", "type": "main", "index": 0 }
        ]
      ]
    },
    "Split Results": { "main": [[{ "node": "Apply Label", "type": "main", "index": 0 }]] },
    "Apply Label": { "main": [[{ "node": "High Priority?", "type": "main", "index": 0 }]] },
    "High Priority?": { "main": [[{ "node": "Ping Owner (Slack)", "type": "main", "index": 0 }], []] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {},
  "tags": [{ "name": "ai" }, { "name": "email-triage" }],
  "meta": { "templateCredsSetupCompleted": false }
}
