{
  "name": "Scrape pages -> AI summarise -> Markdown report by email",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * 1" }] } },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000001",
      "name": "Weekly Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "u1",
              "name": "urls",
              "value": "={{ ['https://example.com/blog/release-notes', 'https://example.com/blog/pricing-update', 'https://example.com/docs/changelog'] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000002",
      "name": "Source URLs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": { "fieldToSplitOut": "urls", "options": { "destinationFieldName": "url" } },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000003",
      "name": "One Item per URL",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 20000,
          "response": { "response": { "responseFormat": "text", "outputPropertyName": "text" } }
        }
      },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000004",
      "name": "Fetch Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "p1", "name": "url", "value": "={{ $('One Item per URL').item.json.url }}", "type": "string" },
            { "id": "p2", "name": "text", "value": "={{ $json.text || '' }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000005",
      "name": "Attach URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 300]
    },
    {
      "parameters": { "aggregate": "aggregateAllItemData", "destinationFieldName": "pages", "options": {} },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000006",
      "name": "Collect Pages",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SIDECAR_URL }}/summarise",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.SIDECAR_API_KEY }}" }]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ report_title: 'Weekly research digest', pages: $json.pages }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000007",
      "name": "Summarise (sidecar)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 300]
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "markdown",
        "binaryPropertyName": "report",
        "options": { "fileName": "=weekly-digest-{{ $now.toFormat('yyyy-LL-dd') }}.md", "encoding": "utf8" }
      },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000008",
      "name": "Markdown to File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [1540, 300]
    },
    {
      "parameters": {
        "sendTo": "research-team@example.test",
        "subject": "={{ $('Summarise (sidecar)').item.json.report_title }} - {{ $now.toFormat('dd LLL yyyy') }}",
        "emailType": "text",
        "message": "={{ $('Summarise (sidecar)').item.json.markdown }}",
        "options": { "attachmentsUi": { "attachmentsBinary": [{ "property": "report" }] } }
      },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000009",
      "name": "Email Report",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1760, 300],
      "credentials": { "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" } }
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "#research" },
        "text": "=:newspaper: {{ $('Summarise (sidecar)').item.json.report_title }} sent ({{ $('Summarise (sidecar)').item.json.pages.length }} pages). Top item: {{ $('Summarise (sidecar)').item.json.pages[0].title }}",
        "otherOptions": {}
      },
      "id": "c3f2e4a6-0003-4c1e-9a00-000000000010",
      "name": "Announce (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1980, 300],
      "credentials": { "slackApi": { "id": "REPLACE_ME", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Weekly Monday 08:00": { "main": [[{ "node": "Source URLs", "type": "main", "index": 0 }]] },
    "Source URLs": { "main": [[{ "node": "One Item per URL", "type": "main", "index": 0 }]] },
    "One Item per URL": { "main": [[{ "node": "Fetch Page", "type": "main", "index": 0 }]] },
    "Fetch Page": { "main": [[{ "node": "Attach URL", "type": "main", "index": 0 }]] },
    "Attach URL": { "main": [[{ "node": "Collect Pages", "type": "main", "index": 0 }]] },
    "Collect Pages": { "main": [[{ "node": "Summarise (sidecar)", "type": "main", "index": 0 }]] },
    "Summarise (sidecar)": { "main": [[{ "node": "Markdown to File", "type": "main", "index": 0 }]] },
    "Markdown to File": { "main": [[{ "node": "Email Report", "type": "main", "index": 0 }]] },
    "Email Report": { "main": [[{ "node": "Announce (Slack)", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {},
  "tags": [{ "name": "ai" }, { "name": "research" }],
  "meta": { "templateCredsSetupCompleted": false }
}
