# ---- App ----------------------------------------------------------------
# development | production | test. production enforces API_KEYS and live-mode tokens.
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Auth ---------------------------------------------------------------
# Comma-separated keys accepted in the X-API-Key header. Empty = auth disabled (dev only).
API_KEYS=change-me
# The same value n8n uses in {{ $env.SIDECAR_API_KEY }} (see docker-compose.yml).
SIDECAR_API_KEY=change-me

# ---- Persistence --------------------------------------------------------
DATABASE_URL=sqlite:///./sidecar.db

# ---- LLM ----------------------------------------------------------------
# fixture (default, offline, deterministic) | claude (needs ANTHROPIC_API_KEY)
LLM_BACKEND=fixture
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- Scoring ------------------------------------------------------------
# Leads scoring >= threshold are "qualified" and take the CRM + booking branch.
SCORE_THRESHOLD=70

# ---- Outbound adapters (dry_run records; live calls the real API) -------
CRM_MODE=dry_run
HUBSPOT_ACCESS_TOKEN=
SLACK_MODE=dry_run
SLACK_BOT_TOKEN=
EMAIL_MODE=dry_run
GMAIL_ACCESS_TOKEN=
EMAIL_FROM=ops@example.test
# live = POST the decision to the n8n Wait-node resume URL; dry_run = log only.
N8N_CALLBACK_MODE=dry_run
